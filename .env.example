# MongoDB Connection String (shared with nechabest.com)
MONGODB_URI="your_mongodb_connection_string"
MONGODB_DB="nechabest"

# Clerk Authentication Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key"
CLERK_SECRET_KEY="your_clerk_secret_key"

# Admin Email Addresses (comma-separated, must match Clerk accounts)
ADMIN_EMAILS="admin@nechabest.com"

# Production URL
NEXT_PUBLIC_APP_URL="https://adventures.nechabest.com"

# Business WhatsApp Number (international format, no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER="256756310029"

# ImgBB API Key (for image uploads)
IMGBB_API_KEY="your_imgbb_api_key_here"

# SMTP Configurations
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER_BOOKINGS="bookings@yourdomain.com"
SMTP_PASS_BOOKINGS="your_bookings_password"
SMTP_USER_INFO="info@yourdomain.com"
SMTP_PASS_INFO="your_info_password"

# Development Only
DEV_ADMIN_PASSWORD="your_dev_password"
# DEV_SKIP_ADMIN_AUTH=true

# Optional
NODE_ENV="production"
