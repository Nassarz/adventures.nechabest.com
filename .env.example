# MongoDB Connection String
MONGODB_URI="your_mongodb_connection_string"

# Clerk Authentication Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="your_clerk_publishable_key"
CLERK_SECRET_KEY="your_clerk_secret_key"

# Admin Email Addresses (comma-separated)
ADMIN_EMAILS="admin@example.com,another@example.com"

# Production URL (Vercel Deployment)
NEXT_PUBLIC_APP_URL="https://nechabest.vercel.app"

# Business WhatsApp Number (international format, no + or spaces)
# All bookings, campaign CTAs and floating chat route to this number.
NEXT_PUBLIC_WHATSAPP_NUMBER="256756310029"

# Formspree Integration (Email Notifications)
NEXT_PUBLIC_FORMSPREE_CONTACT_ENDPOINT="https://formspree.io/f/your_contact_endpoint"
NEXT_PUBLIC_FORMSPREE_BOOKING_ENDPOINT="https://formspree.io/f/your_booking_endpoint"

# Optional: Environment
NODE_ENV="production"

# ImgBB API Key (secure, server-side only)
IMGBB_API_KEY="your_imgbb_api_key_here"

# Outgoing Mail SMTP Configurations
SMTP_HOST="mail.yourdomain.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER_BOOKINGS="bookings@yourdomain.com"
SMTP_PASS_BOOKINGS="your_bookings_password"
SMTP_USER_INFO="info@yourdomain.com"
SMTP_PASS_INFO="your_info_password"

