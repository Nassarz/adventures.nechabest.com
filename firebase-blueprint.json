{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "client"] },
        "photoURL": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Tour": {
      "title": "Tour",
      "description": "Eco-tourism tour package",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "duration": { "type": "string" },
        "image": { "type": "string" },
        "location": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["title", "price", "image"]
    },
    "Project": {
      "title": "Project",
      "description": "Sustainable initiative project",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "year": { "type": "number" },
        "image": { "type": "string" }
      },
      "required": ["title", "category", "image"]
    },
    "Impact": {
      "title": "Impact",
      "description": "Impact metric",
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "value": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["label", "value"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Tour booking",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tourId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "cancelled"] },
        "date": { "type": "string" },
        "guests": { "type": "number" }
      },
      "required": ["userId", "tourId", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/tours/{tourId}": {
      "schema": "Tour",
      "description": "Tour packages"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Research and sustainability projects"
    },
    "/impact/{impactId}": {
      "schema": "Impact",
      "description": "Impact statistics"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "User tour bookings"
    }
  }
}
